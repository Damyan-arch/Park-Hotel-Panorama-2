{
  "name": "park-hotel-panorama-backend",
  "version": "1.0.0",
  "description": "API server for the Park Hotel Panorama redesign mockup",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:frontend": "npm --prefix ../Frontend run build",
    "db:migrate": "typeorm migration:run -d data/data-source.js",
    "db:migrate:revert": "typeorm migration:revert -d data/data-source.js",
    "db:seed": "node data/seed.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "deepl-node": "^1.28.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.3",
    "typeorm": "^1.1.0"
  }
}
