# DeepL API key — get one free at https://www.deepl.com/pro-api
# (Free tier keys end with ":fx" and include 500,000 characters/month at no cost)
# Paste your key below, then copy this file to ".env" (or edit .env directly).
DEEPL_API_KEY=

# PostgreSQL connection — create the database + role in pgAdmin first,
# then fill these in. In production, use the DigitalOcean Managed Postgres
# connection details instead.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=park_hotel_panorama
DB_USER=park_hotel_app
DB_PASSWORD=

# Admin login — no default password on purpose; the server refuses to start
# without ADMIN_PASSWORD set.
ADMIN_EMAILS=damian.tsvetkov@hermeses.com
ADMIN_PASSWORD=

# Where the built frontend is served from, so CORS accepts it
# (comma-separated for multiple origins).
FRONTEND_ORIGIN=http://localhost:4202

# DigitalOcean Spaces — object storage for admin-uploaded images (S3-compatible).
# Create a Space + API key (Spaces Keys) in the DigitalOcean control panel.
SPACES_REGION=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
# Optional: only needed if a CDN endpoint is enabled in front of the Space.
SPACES_CDN_ENDPOINT=
